APP_ENV=development
DEBUG=true
SECRET_KEY=replace-me-with-a-secure-secret
DATABASE_URL=postgresql+psycopg://payrecon:replace-with-local-password@localhost:5432/payrecon
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
INVESTIGATION_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
INVESTIGATION_LLM_TIMEOUT_SECONDS=30
INVESTIGATION_MISSING_PAYMENT_MINUTES=15
INVESTIGATION_WEBHOOK_DELAY_MINUTES=15
INVESTIGATION_MERCHANT_UPDATE_MINUTES=5
INVESTIGATION_CAPTURE_CONFIRMATION_MINUTES=15
INVESTIGATION_ACCOUNTING_DELAY_MINUTES=60
